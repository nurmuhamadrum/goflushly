{
  "name": "go-flushly-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm --workspace=@go-flushly/web run dev",
    "build:web": "npm --workspace=@go-flushly/web run build",
    "preview:web": "npm --workspace=@go-flushly/web run preview",
    "dev:mobile": "npm --workspace=@go-flushly/mobile run start",
    "dev:mobile:ios": "npm --workspace=@go-flushly/mobile run ios",
    "prebuild:ios": "npm --workspace=@go-flushly/mobile exec expo prebuild --platform ios"
  }
}